{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "saleor-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "(BSD-3-Clause AND CC-BY-4.0)",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:ci": "turbo run build:ci",
    "build:adyen": "turbo run build --filter=saleor-app-payment-adyen...",
    "build:adyen:ci": "pnpm run fetch-schema && turbo run build:ci --filter=saleor-app-payment-adyen",
    "generate:adyen": "pnpm --filter saleor-app-payment-adyen generate:app-graphql-types generate:app-webhooks-types",
    "generate": "turbo run generate",
    "check-types": "turbo run check-types",
    "check-spelling": "cspell '**/*.{jsx,tsx,js,ts,md,mdx}'",
    "deploy": "turbo run deploy",
    "dev": "turbo run dev",
    "fetch-schema": "node scripts/fetch-schema.ts",
    "format": "prettier --write '**/*.{jsx,tsx,js,ts,md,mdx}'",
    "github:release": "pnpm changeset tag && git push --follow-tags",
    "knip": "knip --config knip.config.ts",
    "lint": "turbo run lint",
    "lint-staged": "lint-staged",
    "lint:fix": "turbo run lint:fix",
    "lint:packages": "sherif -i tailwindcss -i tailwind-merge",
    "lint:packages:fix": "sherif --fix -i tailwindcss -i tailwind-merge",
    "oss:check": "node oss/export.ts check",
    "oss:export": "node oss/export.ts build",
    "oss:verify": "node oss/export.ts verify",
    "prepare": "husky",
    "start": "turbo run start",
    "start:adyen": "pnpm --filter saleor-app-payment-adyen start",
    "test": "turbo run test",
    "test:ci": "turbo run test:ci"
  },
  "config": {
    "saleor": {
      "schemaVersion": "3.23.45"
    }
  },
  "devDependencies": {
    "@changesets/cli": "2.30.0",
    "@cspell/cspell-types": "8.17.5",
    "@types/node": "catalog:",
    "@saleor/app-sdk": "catalog:",
    "cspell": "8.17.5",
    "graphql": "catalog:",
    "husky": "9.1.4",
    "knip": "5.46.2",
    "lint-staged": "15.5.0",
    "prettier": "3.0.3",
    "sherif": "1.4.0",
    "sort-package-json": "3.0.0",
    "turbo": "2.4.4"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=10.0.0 <11.0.0",
    "pnpm": ">=10.0.0 <11.0.0"
  }
}

# ==========================================
# 1. 核心安全配置 (必填)
# ==========================================
# 生成命令: openssl rand -hex 32 (在 Mac/Linux 或 Git Bash 中运行)
# Windows 下如果没有 openssl，可以直接用任意 32 字节的 Hex 字符串（如 64 个随机的 0-9/a-f 字符）
SECRET_KEY=e085fb1603cc1d62c1fa5e1daec7a40176bbde75bf6d9fdbf2885ec69c105054

# 允许安装该 App 的 Saleor 域名。本地联调建议使用 .* 允许所有，或者精确匹配 localhost
ALLOWED_DOMAIN_PATTERN=.*

# ==========================================
# 2. 本地网络联调配置 (核心)
# ==========================================
# Dashboard 浏览器访问 App 的地址 (宿主机视角)
APP_IFRAME_BASE_URL=http://localhost:3000

# Saleor 容器访问 App API 的地址 (Docker 容器视角)
# 注意: Docker Desktop (Mac/Win) 可用 host.docker.internal
# 如果你是 Linux 原生 Docker，可能需要改为你的宿主机局域网 IP (如 192.168.x.x)
APP_API_BASE_URL=http://host.docker.internal:3000

# ==========================================
# 3. 存储配置 (APL & DynamoDB)
# ==========================================
# 本地开发最简单的方式：使用文件存储 APL，无需启动 DynamoDB 就能完成安装
APL=file
APP_LOG_LEVEL=debug

# --- 以下为 DynamoDB 配置 ---
# 注意：Stripe App 的交易记录强依赖 DynamoDB。
# 如果你需要测试完整的支付链路，必须在本地启动 DynamoDB Local（见下方说明）。
AWS_REGION=localhost
AWS_ACCESS_KEY_ID=fakeMyKeyId
AWS_SECRET_ACCESS_KEY=fakeSecretAccessKey
AWS_ENDPOINT_URL=http://localhost:8000
DYNAMODB_MAIN_TABLE_NAME=stripe-main-table
DYNAMODB_REQUEST_TIMEOUT_MS=5000
DYNAMODB_CONNECTION_TIMEOUT_MS=5000
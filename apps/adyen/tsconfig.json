{
  "extends": "@saleor/typescript-config-apps/base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@/generated/*": ["./generated/*"],
      "@/package.json": ["./package.json"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true,
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "graphql.config.ts",
    "next-env.d.ts",
    "next.config.ts",
    "reset.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "e2e",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/__tests__/**",
    "src/setup-tests.ts",
    "src/setup-tests.tsx"
  ]
}
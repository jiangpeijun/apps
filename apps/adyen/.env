# ==========================================
# 1. 应用核心配置 (必填)
# ==========================================
# Git Bash: openssl rand -hex 32
SECRET_KEY=9d890d596e41747c67b1c9bce09c76af06199e1b0931409b9b8682518a9e8ddc

# 允许安装该 App 的 Saleor 域名，本地开发用 .*
ALLOWED_DOMAIN_PATTERN=.*

# ==========================================
# 2. 本地网络联调配置
# ==========================================
# Dashboard 浏览器访问 App 的地址 https://korea-billy-selection-wishes.trycloudflare.com/api/manifest
# 需要同步修改 ca-test.adyen.com 的 Server configuration 
# https://ca-test.adyen.com/ca/ui/developers/webhooks/notifications/WBHK429BP22322CM5Q9HLQX9L6399S
APP_IFRAME_BASE_URL=https://korea-billy-selection-wishes.trycloudflare.com

# Saleor 容器访问 App API 的地址 (Docker Desktop 使用 host.docker.internal)
APP_API_BASE_URL=https://korea-billy-selection-wishes.trycloudflare.com

# ==========================================
# 3. 存储与日志配置
# ==========================================
# 本地开发建议使用 file，生产环境使用 dynamodb
APL=file
APP_LOG_LEVEL=debug

# ==========================================
# 4. DynamoDB 本地/生产配置
# ==========================================
AWS_REGION=localhost
AWS_ACCESS_KEY_ID=fakeMyKeyId
AWS_SECRET_ACCESS_KEY=fakeSecretAccessKey
# 本地 DynamoDB Local 的地址
AWS_ENDPOINT_URL=http://localhost:8001
DYNAMODB_MAIN_TABLE_NAME=adyen-main-table
DYNAMODB_REQUEST_TIMEOUT_MS=5000
DYNAMODB_CONNECTION_TIMEOUT_MS=5000


{
  "$schema": "https://turbo.build/schema.v2.json",
  "globalDependencies": ["**/.env.*local", "**/.env.production", "schema.graphql", "saleor-json-schemas/**"],
  "globalPassThroughEnv": ["SKIP_ENV_VALIDATION"],
  "globalEnv": [
    "APP_LOG_LEVEL",
    "CI",
    "ENABLE_EXPERIMENTAL_COREPACK",
    "ENV",
    "NEW_SECRET_KEY",
    "NEXT_RUNTIME",
    "NODE_ENV",
    "OTEL_ACCESS_TOKEN",
    "OTEL_ENABLED",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTEL_LOG_LEVEL",
    "OTEL_SERVICE_NAME",
    "OTEL_TRACES_SAMPLER_ARG",
    "OTEL_TRACES_SAMPLER",
    "PORT",
    "REPOSITORY_URL",
    "SENTRY_ORG",
    "VERCEL_ENV",
    "VERCEL_URL",
    "VERCEL"
  ],
  "tasks": {
    "topo": { "dependsOn": ["^topo"] },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", ".vercel/**", "!.next/cache/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.production"],
      "env": ["GITHUB_SHA", "VERCEL_GIT_COMMIT_SHA", "APP_API_BASE_URL", "APP_IFRAME_BASE_URL"]
    },
    "build:ci": {
      "dependsOn": ["topo"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!vercel.json"],
      "outputs": [],
      "passThroughEnv": [
        "ALLOWED_DOMAIN_PATTERN",
        "AWS_REGION",
        "DYNAMODB_MAIN_TABLE_NAME",
        "NEXT_PUBLIC_INITIAL_CHANNEL_SLUG",
        "SECRET_KEY"
      ]
    },
    "check-types": { "dependsOn": ["topo"] },
    "deploy": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", ".vercel/**", "!.next/cache/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "env": ["GITHUB_SHA", "VERCEL_GIT_COMMIT_SHA"]
    },
    "dev": { "dependsOn": ["^dev"], "cache": false, "persistent": true },
    "generate": {
      "inputs": ["**/*.graphql", "**/*.ts", "**/*.tsx", "package.json", "tsconfig.json", "!**/.next/**", "!**/next-env.d.ts"],
      "outputs": ["generated/**"]
    },
    "lint": { "dependsOn": ["topo"] },
    "lint:fix": { "dependsOn": ["topo"] },
    "start": { "dependsOn": ["^build", "^start"], "cache": false, "persistent": true },
    "test": { "cache": false, "persistent": true },
    "test:ci": { "dependsOn": ["topo"], "outputs": ["coverage/**"] }
  }
}
